# Model F Inference Application Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4
ENVIRONMENT=production

# Feature State Storage (Redis backend)
REDIS_URL=redis://localhost:6379/0

# Model Artifact & Audit Logging Configuration
MODEL_PATH=artifacts/model_f_bundle.pkl
AUDIT_LOG_PATH=logs/audit.jsonl

# Operational Guardrails
LOCKED_THRESHOLD=0.50
FALLBACK_RISK_SCORE=0.05
SHADOW_MODE=true
ENFORCE_DECISIONS=false
KILL_SWITCH=false
