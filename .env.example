# Model F Inference Application Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4
ENVIRONMENT=production

# Feature State Storage (Redis backend)
REDIS_URL=redis://localhost:6379/0

# Model Artifact & Audit Logging Configuration
MODEL_PATH=artifacts/model_f_r1_bundle.pkl
MODEL_MANIFEST_PATH=model_f_r1_manifest.json
INFERENCE_CONTRACT_PATH=inference_contract_r1.json
AUDIT_LOG_PATH=logs/audit.jsonl

# Operational Guardrails
LOCKED_THRESHOLD=0.50
FALLBACK_RISK_SCORE=0.05
SHADOW_MODE=true
ENFORCE_DECISIONS=false
KILL_SWITCH=false
# Required for POST /v1/admin/kill-switch; never commit the value.
ADMIN_KILL_SWITCH_TOKEN=replace-with-secret
